{
  "name": "banke-community",
  "version": "1.3.4",
  "description": "Banke weekly planner, blank community edition",
  "productName": "Banke Community",
  "author": "Banke contributors",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test desktop/tests/*.test.cjs tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "pack:win": "electron-builder --win --x64 --dir --publish never",
    "postinstall": "node scripts/install-runtime.cjs",
    "dist:mac": "electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "koffi": "3.3.3"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "org.banke.community.desktop",
    "productName": "Banke Community",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/lib/**",
      "desktop/renderer/**",
      "desktop/assets/**",
      "package.json",
      "LICENSE"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**",
      "node_modules/@koromix/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "desktop/assets/icon.ico",
      "executableName": "BankeCommunity",
      "signAndEditExecutable": true,
      "artifactName": "Banke-Community-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "shortcutName": "Banke Community",
      "uninstallDisplayName": "Banke Community",
      "artifactName": "Banke-Community-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "icon": "desktop/assets/icon-512.png",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "artifactName": "Banke-Community-${version}-macOS-${arch}-preview.${ext}",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "半刻使用同一 Wi-Fi 内的本地网络，与已配对手机加密同步日程。"
      }
    },
    "electronDist": "node_modules/electron/dist"
  }
}
